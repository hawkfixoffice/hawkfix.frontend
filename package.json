{
  "name": "hawkfix-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/check-css.mjs && vite-react-ssg build && node tools/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "content:pull": "node tools/pull-content.mjs",
    "assets:photos": "node tools/fetch-photos.mjs",
    "content:split": "node tools/split-content.mjs",
    "shot": "node tools/shot.mjs",
    "check:css": "node tools/check-css.mjs",
    "seo:keywords": "python3 tools/build-keywords.py",
    "seo:audit": "python3 tools/audit-seo-full.py",
    "assets:images": "sh tools/build-images.sh",
    "assets:lottie": "python3 tools/build-lottie.py"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "puppeteer": "^25.10.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-react-ssg": "^0.9.2"
  }
}
